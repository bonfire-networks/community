# NOTE: ember deps ARE inherited, other flavours deps are NOT. Mess reads exactly two dep lists: this file (which install.sh copies to config/current_flavour/) and the base ember one (config/deps.*, linked in for every flavour) — so anything ember already provides is available here for free.
# But a PARENT flavour contributes no deps: its installer only copies config/, migrations and templates. So every dep that social adds ON TOP of ember and that this flavour wants must be repeated below.

# bonfire = "https://github.com/bonfire-networks/bonfire"
ember = "https://github.com/bonfire-networks/ember"
social = "https://github.com/bonfire-networks/social"
bonfire_messages = "https://github.com/bonfire-networks/bonfire_messages"
bonfire_ui_messages = "https://github.com/bonfire-networks/bonfire_ui_messages"

bonfire_ui_reactions = "https://github.com/bonfire-networks/bonfire_ui_reactions"
bonfire_ui_groups = "https://github.com/bonfire-networks/bonfire_ui_groups"
bonfire_ui_topics = "https://github.com/bonfire-networks/bonfire_ui_topics"
bonfire_classify = "https://github.com/bonfire-networks/bonfire_classify"

bonfire_search = "https://github.com/bonfire-networks/bonfire_search"

bonfire_invite_links= "https://github.com/bonfire-networks/bonfire_invite_links"

bonfire_data_shared_user = "https://github.com/bonfire-networks/bonfire_data_shared_user"

bonfire_api_graphql = "https://github.com/bonfire-networks/bonfire_api_graphql"
# absinthe_client = "https://github.com/bonfire-networks/absinthe_client"

bonfire_open_id = "https://github.com/bonfire-networks/bonfire_open_id"

bonfire_articles = "https://github.com/bonfire-networks/bonfire_articles"

